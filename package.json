{
  "name": "fal-tools-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Private-first, product-agnostic asset generation tools for fal.ai",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --sort build",
    "clean": "pnpm --recursive clean",
    "fal-tools": "node packages/cli/dist/cli.js",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . && node scripts/security-checks.mjs",
    "pack:inspect": "node scripts/inspect-packages.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "sbom": "mkdir -p artifacts && pnpm dlx @cyclonedx/cdxgen@12.7.1 -t nodejs -o artifacts/sbom.cdx.json",
    "test": "vitest run",
    "test:smoke": "node scripts/cli-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.0.0",
    "prettier": "3.9.5",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.0"
  }
}
