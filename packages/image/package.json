{
  "name": "@fal-tools/image",
  "version": "0.1.0",
  "description": "Optional local image processing and objective QA for fal-tools",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fal-tools/core": "workspace:*"
  },
  "optionalDependencies": {
    "sharp": "0.35.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
