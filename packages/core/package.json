{
  "name": "@fal-tools/core",
  "version": "0.1.0",
  "description": "Manifest planning, execution, provenance, auditing, and export primitives",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/sync-package-legal.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "p-limit": "7.3.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
